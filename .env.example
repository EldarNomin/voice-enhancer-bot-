BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
DATABASE_URL=postgresql+asyncpg://voice:voice@postgres:5432/voice
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data/media
ENHANCEMENT_PROVIDER=ffmpeg
DEEPFILTER_BIN=deep-filter
ELEVENLABS_API_KEY=
GLM_API_KEY=
MAX_MEDIA_DURATION_SECONDS=600
MAX_MEDIA_SIZE_BYTES=2147483648
MAX_ACTIVE_JOBS_PER_USER=3
MAX_ACTIVE_JOBS=100
MAX_CONCURRENT_UPLOADS=2
MIN_FREE_DISK_BYTES=1073741824
LOG_LEVEL=INFO

# Optional MAX channel (webhook requires a public HTTPS endpoint on 443).
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_MEDIA_HOSTS=max.ru,okcdn.ru,mycdn.me,userapi.com
# Optional PEM bundle, mounted into api / max-ingress / worker. Never disable TLS.
# MAX_CA_BUNDLE=/etc/ssl/certs/max-trust.pem
GTCRN_MODEL=/opt/models/gtcrn_simple.onnx
